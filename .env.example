DATABASE_URL=postgres://postgres:postgres@localhost:5432/ghost
BETTER_AUTH_SECRET=
API_PORT=3001
BETTER_AUTH_URL=http://localhost:$API_PORT
AUTH_TRUSTED_ORIGINS=http://localhost:3000
# Set in production when web and API share a parent domain, e.g. .example.com
AUTH_COOKIE_DOMAIN=
NEXT_PUBLIC_API_URL=http://localhost:$API_PORT
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=ghost
S3_SECRET_ACCESS_KEY=ghostsecret
S3_BUCKET=ghost

# Origin of the web app; verify and reset-password forms live there.
WEB_APP_URL=http://localhost:3000

# Email verification is opt-in so self-hosted instances work without a mail server.
EMAIL_VERIFICATION_ENABLED=false
EMAIL_SENDER="Ghost <noreply@ghost.local>"
# Either an HTTP relay...
EMAIL_PROXY=
EMAIL_PROXY_SECRET=
# ...or SMTP.
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=

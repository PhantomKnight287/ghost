{
  "name": "@ghost/languages",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun build ./src/index.ts --outdir dist --target node --format esm && tsc -p tsconfig.json",
    "dev": "bun run build",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}

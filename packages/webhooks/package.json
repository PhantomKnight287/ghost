{
  "name": "@ghost/webhooks",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "format": "biome format --write .",
    "test": "bun test"
  },
  "dependencies": {
    "@ghost/permissions": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}

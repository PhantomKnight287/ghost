  "info": {
    "title": "Ghost",
    "description": "API reference for Ghost's API",
    "version": "0.0.1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "CreateRepositoryRequestDTO": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ]
      },
      "CreateRepositoryResponseDTO": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "slug"
        ]
      },
      "ErrorResponseDTO": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        },
        "required": [
          "message"
        ]
      },
      "RepositoryVisibility": {
        "type": "string",
        "enum": [
          "public",
          "private"
        ]
      },
      "RepositoryEntity": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "visibility": {
            "allOf": [
              {
                "$ref": "#/components/schemas/RepositoryVisibility"
              }
            ]
          },
          "lastPushedAt": {
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          },
          "starCount": {
            "type": "number"
          },
          "viewerHasStarred": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "slug",
          "visibility",
          "lastPushedAt",
          "createdAt",
          "updatedAt",
          "starCount",
          "viewerHasStarred"
        ]
      },
      "GetRepositoriesResponseDTO": {
        "type": "object",
        "properties": {
          "repositories": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RepositoryEntity"
            }
          },
          "nextCursor": {
            "type": "string",
            "nullable": true,
            "description": "Pass back as `cursor` for the next page. `null` on the last page."
          },
          "hasMore": {
            "type": "boolean"
          }
        },
        "required": [
          "repositories",
          "nextCursor",
          "hasMore"
        ]
      },
      "StarRepositoryResponseDTO": {
        "type": "object",
        "properties": {
          "starCount": {
            "type": "number"
          },
          "viewerHasStarred": {
            "type": "boolean"
          }
        },
        "required": [
          "starCount",
          "viewerHasStarred"
        ]
      },
      "CommitSummaryDTO": {
        "type": "object",
        "properties": {
          "sha": {
            "type": "string",
            "description": "Full 40-character commit sha."
          },
          "message": {
            "type": "string",
            "description": "Commit subject - the first line of the message."
          },
          "committedAt": {
            "type": "string",
            "description": "Committer timestamp, ISO 8601."
          }
        },
        "required": [
          "sha",
          "message",
          "committedAt"
        ]
      },
      "TreeEntryType": {
        "type": "string",
        "enum": [
          "blob",
          "tree",
          "commit"
        ],
        "description": "`tree` is a directory, `commit` a submodule."
      },
      "TreeEntryDTO": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Entry name within the listed directory."
          },
          "path": {
            "type": "string",
            "description": "Full path from the repository root."
          },
          "type": {
            "description": "`tree` is a directory, `commit` a submodule.",
            "allOf": [
              {
                "$ref": "#/components/schemas/TreeEntryType"
              }
            ]
          },
          "mode": {
            "type": "string",
            "description": "Git file mode, e.g. `100644`.",
            "example": "100644"
          },
          "oid": {
            "type": "string",
            "description": "Object id of the blob or tree."
          },
          "size": {
            "type": "number",
            "nullable": true,
            "description": "Blob size in bytes; `null` for trees and submodules."
          },
          "lastCommit": {
            "nullable": true,
            "description": "Newest commit touching this entry, or anything beneath it for a tree. `null` only if the index has not caught up with the ref.",
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/CommitSummaryDTO"
              }
            ]
          }
        },
        "required": [
          "name",
          "path",
          "type",
          "mode",
          "oid",
          "size",
          "lastCommit"
        ]
      },
      "GetRepositoryContentsResponseDTO": {
        "type": "object",
        "properties": {
          "ref": {
            "type": "string",
            "description": "Ref that was listed, always fully qualified.",
            "example": "refs/heads/main"
          },
          "path": {
            "type": "string",
            "description": "Normalized directory that was listed, with a trailing slash. Empty at the root.",
            "example": "src/services/"
          },
          "commitCount": {
            "type": "number",
            "description": "Commits reachable from the ref. `0` for an unborn ref.",
            "example": 128
          },
          "commit": {
            "nullable": true,
            "description": "Tip commit of the ref. `null` when nothing has been pushed yet.",
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/CommitSummaryDTO"
              }
            ]
          },
          "entries": {
            "description": "One level of the directory: directories first (submodules among them), then files, each group alphabetical. Case is a minor difference, so `readme.md` and `README.md` sit together rather than in separate blocks, and embedded numbers order naturally (`file2` before `file10`). Empty for an unborn ref or a path that is not a directory.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TreeEntryDTO"
            }
          }
        },
        "required": [
          "ref",
          "path",
          "commitCount",
          "commit",
          "entries"
        ]
      },
      "BlobEncoding": {
        "type": "string",
        "enum": [
          "utf-8",
          "base64"
        ],
        "description": "`base64` for binary files, and for anything that is not valid UTF-8."
      },
      "GetRepositoryBlobResponseDTO": {
        "type": "object",
        "properties": {
          "ref": {
            "type": "string",
            "description": "Ref that was read, always fully qualified.",
            "example": "refs/heads/main"
          },
          "path": {
            "type": "string",
            "description": "Normalized path of the file.",
            "example": "src/main.ts"
          },
          "oid": {
            "type": "string",
            "description": "Object id of the blob."
          },
          "size": {
            "type": "number",
            "description": "File size in bytes."
          },
          "encoding": {
            "description": "`base64` for binary files, and for anything that is not valid UTF-8.",
            "allOf": [
              {
                "$ref": "#/components/schemas/BlobEncoding"
              }
            ]
          },
          "content": {
            "type": "string",
            "nullable": true,
            "description": "File contents, `null` when the file is past the inline size limit."
          },
          "commit": {
            "nullable": true,
            "description": "Newest commit touching this file.",
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/CommitSummaryDTO"
              }
            ]
          }
        },
        "required": [
          "ref",
          "path",
          "oid",
          "size",
          "encoding",
          "content",
          "commit"
        ]
      },
      "CommitDTO": {
        "type": "object",
        "properties": {
          "sha": {
            "type": "string",
            "description": "Full 40-character commit sha."
          },
          "subject": {
            "type": "string",
            "description": "Commit subject, the first line of the message."
          },
          "body": {
            "type": "string",
            "description": "The rest of the message. Empty when there is none."
          },
          "authorName": {
            "type": "string"
          },
          "authorEmail": {
            "type": "string"
          },
          "committedAt": {
            "type": "string",
            "description": "Committer timestamp, ISO 8601."
          }
        },
        "required": [
          "sha",
          "subject",
          "body",
          "authorName",
          "authorEmail",
          "committedAt"
        ]
      },
      "GetRepositoryCommitsResponseDTO": {
        "type": "object",
        "properties": {
          "ref": {
            "type": "string",
            "description": "Ref that was walked, always fully qualified.",
            "example": "refs/heads/main"
          },
          "from": {
            "type": "number",
            "description": "Position of this page's first commit in the walk, 1-based. `0` when the page is empty.",
            "example": 41
          },
          "to": {
            "type": "number",
            "description": "Position of this page's last commit. `0` when the page is empty.",
            "example": 60
          },
          "total": {
            "type": "number",
            "description": "Commits the walk can reach in total, narrowed by `path` when one is given.",
            "example": 128
          },
          "commits": {
            "description": "Newest first.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CommitDTO"
            }
          },
          "nextCursor": {
            "type": "string",
            "nullable": true,
            "description": "Pass back as `cursor` for the next page. `null` on the last page."
          }
        },
        "required": [
          "ref",
          "from",
          "to",
          "total",
          "commits",
          "nextCursor"
        ]
      },
      "CommitFileDTO": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "`A` added, `M` modified, `D` deleted."
          },
          "path": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "path"
        ]
      },
      "GetRepositoryCommitResponseDTO": {
        "type": "object",
        "properties": {
          "sha": {
            "type": "string",
            "description": "Full 40-character commit sha."
          },
          "subject": {
            "type": "string",
            "description": "Commit subject, the first line of the message."
          },
          "body": {
            "type": "string",
            "description": "The rest of the message. Empty when there is none."
          },
          "authorName": {
            "type": "string"
          },
          "authorEmail": {
            "type": "string"
          },
          "committedAt": {
            "type": "string",
            "description": "Committer timestamp, ISO 8601."
          },
          "files": {
            "description": "Paths this commit changed, against its first parent.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CommitFileDTO"
            }
          }
        },
        "required": [
          "sha",
          "subject",
          "body",
          "authorName",
          "authorEmail",
          "committedAt",
          "files"
        ]
      },
      "GetRepositoryBranchesResponseDTO": {
        "type": "object",
        "properties": {
          "defaultBranch": {
            "type": "string",
            "nullable": true,
            "description": "Branch the repository opens on. `null` when nothing has been pushed yet.",
            "example": "main"
          },
          "branches": {
            "description": "Branch names, without the `refs/heads/` prefix, ordered by name.",
            "example": [
              "main",
              "feat/contents"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "defaultBranch",
          "branches"
        ]
      }
    }
  }
}

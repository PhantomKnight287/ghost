[
  {
    "command": "gh repo view <host>/<login>/tools --json name,owner,visibility,defaultBranchRef",
    "requests": [
      {
        "method": "POST",
        "path": "/api/graphql",
        "query": {},
        "headers": {
          "accept": "application/json",
          "content-type": "application/json; charset=utf-8",
          "graphql-features": "merge_queue",
          "x-github-api-version": "2022-11-28"
        },
        "body": {
          "query": "query RepositoryInfo($owner: String!, $name: String!) {\n\t\trepository(owner: $owner, name: $name) {name,owner{id,login},visibility,defaultBranchRef{name}}\n\t}",
          "variables": {
            "name": "tools",
            "owner": "<login>"
          }
        },
        "status": 200
      }
    ]
  }
]

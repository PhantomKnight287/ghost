[
  {
    "command": "gh issue list -R <host>/<login>/tools --search build --json title",
    "requests": [
      {
        "method": "GET",
        "path": "/api/v3/meta",
        "query": {},
        "headers": {
          "accept": "application/json",
          "content-type": "application/json; charset=utf-8",
          "x-github-api-version": "2022-11-28"
        },
        "body": null,
        "status": 200
      },
      {
        "method": "POST",
        "path": "/api/graphql",
        "query": {},
        "headers": {
          "accept": "application/json",
          "content-type": "application/json; charset=utf-8",
          "graphql-features": "merge_queue",
          "x-github-api-version": "2022-11-28"
        },
        "body": {
          "query": "fragment issue on Issue {title}query IssueSearch($repo: String!, $owner: String!, $type: SearchType!, $limit: Int, $after: String, $query: String!) {\n\t\t\trepository(name: $repo, owner: $owner) {\n\t\t\t\thasIssuesEnabled\n\t\t\t}\n\t\t\tsearch(type: $type, last: $limit, after: $after, query: $query) {\n\t\t\t\tissueCount\n\t\t\t\tnodes { ...issue }\n\t\t\t\tpageInfo {\n\t\t\t\t\thasNextPage\n\t\t\t\t\tendCursor\n\t\t\t\t}\n\t\t\t}\n\t\t}",
          "variables": {
            "limit": 30,
            "owner": "<login>",
            "query": "build repo:<login>/tools state:open type:issue",
            "repo": "tools",
            "type": "ISSUE"
          }
        },
        "status": 200
      }
    ]
  }
]

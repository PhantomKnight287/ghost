[
  {
    "command": "gh release list -R <host>/<login>/tools --json tagName,name,isDraft,isPrerelease,isLatest,publishedAt",
    "requests": [
      {
        "method": "POST",
        "path": "/api/graphql",
        "query": {},
        "headers": {
          "accept": "application/json",
          "content-type": "application/json",
          "graphql-features": "merge_queue",
          "x-github-api-version": "2022-11-28"
        },
        "body": {
          "query": "query Release_fields{Release: __type(name: \"Release\"){fields{name}}}"
        },
        "status": 200
      },
      {
        "method": "POST",
        "path": "/api/graphql",
        "query": {},
        "headers": {
          "accept": "application/json",
          "content-type": "application/json",
          "graphql-features": "merge_queue",
          "x-github-api-version": "2022-11-28"
        },
        "body": {
          "query": "query RepositoryReleaseList($direction:OrderDirection!$endCursor:String$name:String!$owner:String!$perPage:Int!){repository(owner: $owner, name: $name){releases(first: $perPage, orderBy: {field: CREATED_AT, direction: $direction}, after: $endCursor){nodes{name,tagName,isDraft,isLatest,isPrerelease,createdAt,publishedAt},pageInfo{hasNextPage,endCursor}}}}",
          "variables": {
            "direction": "DESC",
            "endCursor": null,
            "name": "tools",
            "owner": "<login>",
            "perPage": 30
          }
        },
        "status": 200
      }
    ]
  }
]

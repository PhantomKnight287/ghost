{
  "name": "ghost",
  "private": true,
  "version": "0.0.0",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "dotenv -e .env turbo run build",
    "dev": "dotenv -e .env turbo run dev",
    "lint": "dotenv -e .env turbo run lint",
    "test": "dotenv -e .env turbo run test",
    "check-types": "dotenv -e .env turbo run check-types",
    "db:generate": "dotenv -e .env turbo run db:generate",
    "db:migrate": "dotenv -e .env turbo run db:migrate",
    "db:push": "dotenv -e .env turbo run db:push",
    "db:studio": "dotenv -e .env -- bun run --filter @ghost/db db:studio",
    "openapi": "dotenv -e .env -- bun run --filter @ghost/api openapi && bun run --filter @ghost/web generate",
    "format": "turbo run format",
    "format:check": "biome format ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "railway": "3.11.0",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv-cli": "^11.0.0"
  }
}
